<!--
  Значок в строке состояния.

  Android рисует его как силуэт: любой цвет заменяется белым, а полутона —
  прозрачностью. Поэтому здесь только форма, без градиентов и заливок цветом.
  Раньше сюда подставлялся ic_launcher_foreground — цветная картинка лаунчера,
  из которой система делала белое пятно.

  Рыба смотрит влево, хвост справа: так силуэт читается даже в 24 пикселя.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!--
      Тело и глаз одной фигурой: evenOdd вырезает глаз насквозь, иначе на
      белом силуэте его было бы не видно.
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M9.6,5.2 C13,4.6 16.2,6.1 18,9.2 L20.4,12 L18,14.8 C16.2,17.9 13,19.4 9.6,18.8 C6.2,18.2 3.6,15.6 2.6,12 C3.6,8.4 6.2,5.8 9.6,5.2 Z M7.1,10.3 C6.2,10.3 5.5,11 5.5,11.9 C5.5,12.8 6.2,13.5 7.1,13.5 C8,13.5 8.7,12.8 8.7,11.9 C8.7,11 8,10.3 7.1,10.3 Z" />

    <!-- Хвост: две лопасти от того же корня, что и тело. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M19.2,12 L23,7.6 L22.3,12 L23,16.4 Z" />
</vector>
