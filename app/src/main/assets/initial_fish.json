    "guild": "peaceful",
    "light_activity": { "night": 0.7, "dawn": 1.0, "morning": 0.9, "day": 0.5, "evening": 0.9, "dusk": 1.0 },
    "preferred_structures": [
      "gravel_silt_edge",
      "drop_off",
      "flooded_channel",
