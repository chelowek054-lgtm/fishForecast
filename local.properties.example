# Шаблон локальных настроек. Скопируйте в local.properties (тот файл в .gitignore
# и в репозиторий не попадает) и подставьте свои значения.
#
#   cp local.properties.example local.properties
#
# Путь к Android SDK. Android Studio прописывает его сам при первом открытии.
sdk.dir=C\:\Users\ИМЯ\AppData\Local\Android\Sdk

# ─── Детальные спутниковые снимки (необязательно) ────────────────────────────
#
# Без ключа приложение показывает Sentinel-2: снимки открытые и работают
# офлайн, но разрешение 10 м на пиксель — берег виден, отмель уже нет.
#
# Ключ включает снимки около метра. Достаточно ОДНОГО из двух.
# Детальные снимки доступны только при сети: оба провайдера запрещают
# массовую предзагрузку тайлов на бесплатных тарифах.

# MapTiler — cloud.maptiler.com, регистрация без банковской карты,
# на карте показывается логотип MapTiler.
#MAPTILER_KEY=сюда_ключ_MapTiler

# Mapbox — account.mapbox.com, 50 000 загрузок карты в месяц,
# коммерческое использование разрешено тарифом.
#MAPBOX_TOKEN=сюда_токен_Mapbox
